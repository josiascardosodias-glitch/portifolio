# Copie este arquivo para .env e preencha os valores.

# Porta do servidor de desenvolvimento (lida só pelo vite.config, não vai para o site)
PORT=5173

# Contato e redes sociais (o prefixo VITE_ deixa o valor disponível no site)
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
